  "main": "social_handler.py",
  "scripts": {
    "start": "python3 social_handler.py",
    "test": "python3 -m unittest discover tests",
    "update-metadata": "python3 page_metadata_updater.py"
  },
  "author": "Miles Xiang & Red Anchor Lab",
