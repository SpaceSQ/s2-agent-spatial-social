    },
    "extensions": [
      "./openclaw.plugin.json"
    ]
  },
  "dependencies": {
    "s2-spatial-os-kernel": "^1.0.0"
  },
  "keywords": [
    "Space2",
    "SSSU",
    "AgentPage",
    "Spatial-Social",
    "Sovereign-Identity",
    "SUNS"
